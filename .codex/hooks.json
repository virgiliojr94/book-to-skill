{
  "description": "Defense-in-depth factory policy for shell commands.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/block-merge.sh\"",
            "statusMessage": "Checking factory policy"
          }
        ]
      }
    ]
  }
}
